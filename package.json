{
  "name": "clearspace-matrix",
  "version": "2.0.0",
  "private": true,
  "description": "A personal Eisenhower Matrix with browser storage and local development tools.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test tests/worker.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs && node scripts/validate-artifact.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "serve:worker": "node scripts/serve.mjs",
    "dev:mobile": "vite --host 0.0.0.0",
    "lint:fix": "npm run lint -- --fix",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@heroicons/react": "^2.2.0",
    "motion": "^14.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
