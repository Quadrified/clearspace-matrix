{
  "name": "clearspace-matrix",
  "version": "2.0.0",
  "private": true,
  "description": "A personal Eisenhower Matrix with browser storage and local development tools.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test tests/worker.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs && node scripts/validate-artifact.mjs",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts worker *.json *.ts *.html .github/workflows/*.yml",
    "serve:worker": "node scripts/serve.mjs",
    "dev:mobile": "vite --host 0.0.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@heroicons/react": "^2.2.0",
    "motion": "^14.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
